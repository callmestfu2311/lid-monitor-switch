<#
.SYNOPSIS
    Automatically switches the laptop lid close action
    based on whether an external monitor is connected.
.DESCRIPTION
    - External monitor connected  -> lid close = "Do nothing", auto-lock disabled
    - No external monitor         -> lid close = "Sleep", auto-lock enabled
    Runs in the background and polls for display changes
    via WMI every 5 seconds.
#>
$LogPath = "C:\Users\digma\.gemini\antigravity\scratch\lid-guard.log"
function Write-Log {
    param([string]$Message)
    $timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "[$timestamp] $Message"
    Write-Host $line
    try {
        Add-Content -Path $LogPath -Value $line -ErrorAction SilentlyContinue
    } catch {}
}
# -- powercfg constants ---------------------------------------------------
$LidSubgroup     = '4f971e89-eebd-4455-a8de-9e59040e7347'
$LidSetting      = '5ca83367-6e45-459f-a27b-476b1d01c936'
$ConsoleLockGuid = '0e796bdb-100d-47d6-a2d5-f7d2daa51f51'
$SubNone         = 'fea3413e-7e05-4911-9a71-700331f1c294'
$ActionDoNothing = 0
$ActionSleep     = 1
# -- Functions -------------------------------------------------------------
function Has-ExternalMonitor {
    try {
        $connParams = Get-CimInstance -Namespace root\wmi -ClassName WmiMonitorConnectionParams -ErrorAction SilentlyContinue
        if ($connParams) {
            # 2147483648 (0x80000000 = Internal panel), 11 = DisplayPort Embedded (eDP)
            $external = @($connParams | Where-Object { $_.Active -and ($_.VideoOutputTechnology -ne 2147483648) -and ($_.VideoOutputTechnology -ne 11) })
            if ($external.Count -gt 0) {
                return $true
            }
        }
        # Fallback check via WmiMonitorID if ConnectionParams unavailable
        $ids = Get-CimInstance -Namespace root\wmi -ClassName WmiMonitorID -ErrorAction SilentlyContinue
        if ($ids) {
            $extIds = @($ids | Where-Object { $_.InstanceName -notmatch 'BOE|INTERNAL|eDP' })
            return ($extIds.Count -gt 0)
        }
    } catch {
        Write-Log "Error checking monitors: $_"
    }
    return $false
